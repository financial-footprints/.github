meta {
  name: get job missing
  type: http
  seq: 25
}

get {
  url: {{syncUrl}}/api/v1/sync/jobs/{{unknownUuid}}
}

headers {
  Authorization: Bearer {{aliceAccessToken}}
  X-User-Id: {{userId}}
  X-Vault-Verification: {{vaultVerification}}
}

tests {
  test("404", function () {
    expect(res.getStatus()).to.equal(404);
    expect(String(res.getBody().details)).to.include("job not found");
  });
}

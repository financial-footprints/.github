meta {
  name: list jobs
  type: http
  seq: 23
}

get {
  url: {{syncUrl}}/api/v1/sync/jobs
}

headers {
  Authorization: Bearer {{aliceAccessToken}}
  X-User-Id: {{userId}}
  X-Vault-Verification: {{vaultVerification}}
}

tests {
  test("job list", function () {
    expect(res.getStatus()).to.equal(200);
    expect(res.getBody().data.items).to.be.an("array");
  });
}

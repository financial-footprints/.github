meta {
  name: firefly put settings
  type: http
  seq: 30
}

put {
  url: {{syncUrl}}/api/v1/sync/integrations/firefly
  body: json
}

headers {
  Authorization: Bearer {{aliceAccessToken}}
  X-User-Id: {{userId}}
  X-Vault-Verification: {{vaultVerification}}
  Content-Type: application/json
}

body:json {
  {
    "url": "http://127.0.0.1:39999",
    "token": "dummy-token",
    "currency": "INR"
  }
}

tests {
  test("configured", function () {
    expect(res.getStatus()).to.equal(200);
    expect(res.getBody().data.configured).to.equal(true);
    expect(res.getBody().data.has_token).to.equal(true);
    expect(res.getBody().data.url).to.equal("http://127.0.0.1:39999");
  });
}

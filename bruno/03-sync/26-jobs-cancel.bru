meta {
  name: cancel job
  type: http
  seq: 26
}

post {
  url: {{syncUrl}}/api/v1/sync/jobs/{{pipelineJobId}}/cancel
}

headers {
  Authorization: Bearer {{aliceAccessToken}}
  X-User-Id: {{userId}}
  X-Vault-Verification: {{vaultVerification}}
}

tests {
  test("cancel idempotent", function () {
    expect(res.getStatus()).to.equal(200);
    expect(res.getBody().data.id).to.equal(bru.getVar("pipelineJobId"));
  });
}

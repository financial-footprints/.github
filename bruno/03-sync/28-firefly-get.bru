meta {
  name: firefly status unconfigured
  type: http
  seq: 28
}

get {
  url: {{syncUrl}}/api/v1/sync/integrations/firefly
}

headers {
  Authorization: Bearer {{aliceAccessToken}}
  X-User-Id: {{userId}}
  X-Vault-Verification: {{vaultVerification}}
}

tests {
  test("not configured", function () {
    expect(res.getStatus()).to.equal(200);
    expect(res.getBody().data.configured).to.equal(false);
  });
}

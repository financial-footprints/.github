meta {
  name: sources backup secrets
  type: http
  seq: 37
}

get {
  url: {{syncUrl}}/api/v1/sync/integrations/sources/backup/secrets
}

headers {
  Authorization: Bearer {{aliceAccessToken}}
  X-User-Id: {{userId}}
  X-Vault-Verification: {{vaultVerification}}
}

tests {
  test("plaintext sources for backup", function () {
    expect(res.getStatus()).to.equal(200);
    const items = res.getBody().data.items;
    expect(Array.isArray(items)).to.equal(true);
  });
}

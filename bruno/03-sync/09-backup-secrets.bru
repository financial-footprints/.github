meta {
  name: backup secrets
  type: http
  seq: 9
}

get {
  url: {{syncUrl}}/api/v1/sync/accounts/backup/secrets
}

headers {
  Authorization: Bearer {{aliceAccessToken}}
  X-User-Id: {{userId}}
  X-Vault-Verification: {{vaultVerification}}
}

tests {
  test("plaintext secrets for backup", function () {
    expect(res.getStatus()).to.equal(200);
    const items = res.getBody().data.items;
    expect(items.some((item) => item.id === bru.getEnvVar("accountId"))).to.equal(true);
  });
}

meta {
  name: update account
  type: http
  seq: 9
}

put {
  url: {{dbUrl}}/api/v1/accounts/{{extraAccountId}}
  body: json
}

headers {
  Authorization: Bearer {{aliceAccessToken}}
  X-User-Id: {{userId}}
  X-Vault-Verification: {{vaultVerification}}
  Content-Type: application/json
}

body:json {
  {
    "closing_date": "2024-12-31"
  }
}

tests {
  test("updated", function () {
    expect(res.getStatus()).to.equal(200);
    expect(res.getBody().data.closing_date).to.equal("2024-12-31");
  });
}

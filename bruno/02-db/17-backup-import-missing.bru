meta {
  name: backup import missing file
  type: http
  seq: 17
}

post {
  url: {{dbUrl}}/api/v1/accounts/backup/import
  body: multipartForm
}

headers {
  Authorization: Bearer {{aliceAccessToken}}
  X-User-Id: {{userId}}
  X-Vault-Verification: {{vaultVerification}}
}

body:multipart-form {
  zip_password: unused
}

tests {
  test("422 file required", function () {
    expect(res.getStatus()).to.equal(422);
    expect(res.getBody().details).to.equal("backup zip file is required");
  });
}

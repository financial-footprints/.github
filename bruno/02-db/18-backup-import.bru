meta {
  name: backup import zip
  type: http
  seq: 18
}

post {
  url: {{dbUrl}}/api/v1/accounts/backup/import
  body: multipartForm
}

headers {
  Authorization: Bearer {{aliceAccessToken}}
  X-User-Id: {{userId}}
  X-Vault-Verification: {{vaultVerification}}
}

body:multipart-form {
  file: @file(fixtures/generated-backup.zip)
}

tests {
  test("import 200", function () {
    expect(res.getStatus()).to.equal(200);
    const data = res.getBody().data;
    expect(data.results).to.be.an("array");
    expect(data.errors).to.be.an("array");
  });
}

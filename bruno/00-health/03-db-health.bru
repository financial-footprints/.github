meta {
  name: DB health
  type: http
  seq: 3
}

get {
  url: {{dbUrl}}/api/v1/accounts/health
}

tests {
  test("200 status ok", function () {
    expect(res.getStatus()).to.equal(200);
    const body = res.getBody();
    expect(body.status).to.equal("ok");
    expect(body.version).to.be.a("string");
  });
}

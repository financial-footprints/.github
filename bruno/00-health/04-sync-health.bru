meta {
  name: Sync health
  type: http
  seq: 4
}

get {
  url: {{syncUrl}}/api/v1/sync/health
}

tests {
  test("200 status ok", function () {
    expect(res.getStatus()).to.equal(200);
    const body = res.getBody();
    expect(body.status).to.equal("ok");
    expect(body.data).to.equal(undefined);
  });
}

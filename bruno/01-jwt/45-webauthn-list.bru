meta {
  name: webauthn credentials list
  type: http
  seq: 45
}

get {
  url: {{jwtUrl}}/api/v1/auth/mfa/webauthn/credentials
}

headers {
  Authorization: Bearer {{aliceAccessToken}}
}

tests {
  test("empty credentials", function () {
    expect(res.getStatus()).to.equal(200);
    expect(res.getBody().data.items).to.eql([]);
    expect(res.getBody().data.total).to.equal(0);
  });
}

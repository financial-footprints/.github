meta {
  name: mfa verify with access token
  type: http
  seq: 42
}

post {
  url: {{jwtUrl}}/api/v1/auth/mfa/verify
  body: json
}

headers {
  Authorization: Bearer {{aliceAccessToken}}
  Content-Type: application/json
}

body:json {
  {
    "totp": "000000"
  }
}

tests {
  test("401 unauthorized", function () {
    expect(res.getStatus()).to.equal(401);
    expect(res.getBody().details).to.equal("unauthorized");
  });
}

meta {
  name: patch me e2ee name without vault
  type: http
  seq: 18
}

patch {
  url: {{jwtUrl}}/api/v1/auth/me
  body: json
}

headers {
  Authorization: Bearer {{adminAccessToken}}
  Content-Type: application/json
}

body:json {
  {
    "e2ee_name": "nonce.ciphertext"
  }
}

tests {
  test("409 vault not initialized", function () {
    expect(res.getStatus()).to.equal(409);
    expect(res.getBody().details).to.equal("vault not initialized");
  });
}

meta {
  name: list users invalid role filter
  type: http
  seq: 26
}

get {
  url: {{jwtUrl}}/api/v1/auth/users?filters.role=nope
}

headers {
  Authorization: Bearer {{managerAccessToken}}
}

tests {
  test("400 invalid role filter", function () {
    expect(res.getStatus()).to.equal(400);
    expect(res.getBody().details).to.equal("invalid filters.role");
  });
}

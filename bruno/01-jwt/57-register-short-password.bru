meta {
  name: register short password
  type: http
  seq: 57
}

post {
  url: {{jwtUrl}}/api/v1/auth/register
  body: json
}

headers {
  Authorization: Bearer {{adminAccessToken}}
  Content-Type: application/json
}

body:json {
  {
    "username": "shortpwd",
    "password": "short"
  }
}

tests {
  test("400 password policy", function () {
    expect(res.getStatus()).to.equal(400);
    expect(res.getBody().details).to.include("password must be");
  });
}

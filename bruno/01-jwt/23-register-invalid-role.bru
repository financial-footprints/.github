meta {
  name: register invalid role
  type: http
  seq: 23
}

post {
  url: {{jwtUrl}}/api/v1/auth/register
  body: json
}

headers {
  Authorization: Bearer {{adminAccessToken}}
  Content-Type: application/json
}

body:json {
  {
    "username": "badrole",
    "password": "password123",
    "role": "superadmin"
  }
}

tests {
  test("400 invalid role", function () {
    expect(res.getStatus()).to.equal(400);
    expect(res.getBody().details).to.equal("invalid role");
  });
}

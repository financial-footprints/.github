meta {
  name: recovery email set
  type: http
  seq: 49
}

put {
  url: {{jwtUrl}}/api/v1/auth/recovery/email
  body: json
}

headers {
  Authorization: Bearer {{aliceAccessToken}}
  Content-Type: application/json
}

body:json {
  {
    "email": "alice@example.com",
    "password": "password123"
  }
}

tests {
  test("email stored", function () {
    expect(res.getStatus()).to.equal(200);
    expect(res.getBody().data).to.equal(null);
  });
}

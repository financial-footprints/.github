meta {
  name: login finish bad challenge
  type: http
  seq: 5
}

post {
  url: {{jwtUrl}}/api/v1/auth/login/finish
  body: json
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "challenge_id": "00000000-0000-4000-8000-000000000000",
    "client_public": "",
    "client_proof": "AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA"
  }
}

tests {
  test("401 invalid credentials", function () {
    expect(res.getStatus()).to.equal(401);
    expect(res.getBody().details).to.equal("invalid credentials");
  });
}

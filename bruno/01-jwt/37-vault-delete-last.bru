meta {
  name: vault delete last slot
  type: http
  seq: 37
}

delete {
  url: {{jwtUrl}}/api/v1/auth/me/vault/slots/{{passwordSlotId}}
  body: json
}

headers {
  Authorization: Bearer {{aliceAccessToken}}
  Content-Type: application/json
}

body:json {
  {
    "password": "password123"
  }
}

tests {
  test("409 last slot", function () {
    expect(res.getStatus()).to.equal(409);
    expect(res.getBody().details).to.equal("cannot delete last vault slot");
  });
}

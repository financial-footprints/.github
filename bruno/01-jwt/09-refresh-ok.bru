meta {
  name: refresh ok then reuse
  type: http
  seq: 9
}

post {
  url: {{jwtUrl}}/api/v1/auth/refresh
  body: json
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "refresh_token": "{{adminRefreshToken}}"
  }
}

tests {
  test("rotates tokens", function () {
    expect(res.getStatus()).to.equal(200);
    const data = res.getBody().data;
    expect(data.access_token).to.be.a("string");
    expect(data.refresh_token).to.be.a("string");
    expect(data.token_type).to.equal("Bearer");
    bru.setVar("adminAccessTokenRotated", data.access_token);
  });
}

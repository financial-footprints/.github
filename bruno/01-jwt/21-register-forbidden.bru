meta {
  name: register forbidden for manager
  type: http
  seq: 21
}

post {
  url: {{jwtUrl}}/api/v1/auth/register
  body: json
}

headers {
  Authorization: Bearer {{managerAccessToken}}
  Content-Type: application/json
}

body:json {
  {
    "username": "nope",
    "password": "password123"
  }
}

tests {
  test("403 forbidden", function () {
    expect(res.getStatus()).to.equal(403);
    expect(res.getBody().details).to.equal("forbidden");
  });
}

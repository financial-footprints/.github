meta {
  name: patch own role forbidden
  type: http
  seq: 28
}

patch {
  url: {{jwtUrl}}/api/v1/auth/users/{{adminId}}
  body: json
}

headers {
  Authorization: Bearer {{adminAccessToken}}
  Content-Type: application/json
}

body:json {
  {
    "role": "user"
  }
}

tests {
  test("cannot change own role", function () {
    expect(res.getStatus()).to.equal(400);
    expect(res.getBody().details).to.equal("cannot change your own role");
  });
}

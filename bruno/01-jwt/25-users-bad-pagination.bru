meta {
  name: list users invalid pagination
  type: http
  seq: 25
}

get {
  url: {{jwtUrl}}/api/v1/auth/users?pagination.limit=0
}

headers {
  Authorization: Bearer {{adminAccessToken}}
}

tests {
  test("400 invalid limit", function () {
    expect(res.getStatus()).to.equal(400);
    expect(res.getBody().details).to.equal("invalid pagination.limit");
  });
}

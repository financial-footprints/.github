meta {
  name: recovery advanced webauthn begin
  type: http
  seq: 60
}

post {
  url: {{jwtUrl}}/api/v1/auth/recovery/advanced/webauthn/begin
  body: json
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "token": "not-a-token"
  }
}

tests {
  test("400 invalid token", function () {
    expect(res.getStatus()).to.equal(400);
    expect(res.getBody().details).to.equal("invalid or expired token");
  });
}

meta {
  name: vault rejects plaintext phrase
  type: http
  seq: 33
}

post {
  url: {{jwtUrl}}/api/v1/auth/me/vault/initialize
  body: json
}

headers {
  Authorization: Bearer {{adminAccessToken}}
  Content-Type: application/json
}

body:json {
  {
    "phrase": "abandon abandon abandon abandon abandon abandon abandon abandon abandon abandon abandon about",
    "slots": [
      {
        "slot_type": "recovery_phrase",
        "salt": "AQIDBAUGBwgJCgsMDQ4PEA",
        "wrap_blob": "abc.def"
      }
    ]
  }
}

tests {
  test("400 plaintext secrets", function () {
    expect(res.getStatus()).to.equal(400);
    expect(res.getBody().details).to.equal("plaintext recovery secrets must not be sent to the server");
  });
}

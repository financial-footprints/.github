meta {
  name: password unauthorized
  type: http
  seq: 16
}

post {
  url: {{jwtUrl}}/api/v1/auth/password
  body: json
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "current_password": "password123",
    "new_password": "password456"
  }
}

tests {
  test("401 unauthorized", function () {
    expect(res.getStatus()).to.equal(401);
    expect(res.getBody().details).to.equal("unauthorized");
  });
}

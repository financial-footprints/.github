meta {
  name: recovery generate without mfa
  type: http
  seq: 43
}

post {
  url: {{jwtUrl}}/api/v1/auth/mfa/recovery/generate
  body: json
}

headers {
  Authorization: Bearer {{aliceAccessToken}}
  Content-Type: application/json
}

body:json {
  {
    "totp": "000000"
  }
}

tests {
  test("400 mfa not enabled", function () {
    expect(res.getStatus()).to.equal(400);
    expect(res.getBody().details).to.equal("mfa not enabled");
  });
}

meta {
  name: recovery password complete bad token
  type: http
  seq: 52
}

post {
  url: {{jwtUrl}}/api/v1/auth/recovery/password/complete
  body: json
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "token": "not-a-token",
    "new_password": "password123",
    "totp": "000000"
  }
}

tests {
  test("400 invalid token", function () {
    expect(res.getStatus()).to.equal(400);
    const details = res.getBody().details;
    expect(details === "invalid or expired token" || details === "mfa proof required").to.equal(true);
  });
}

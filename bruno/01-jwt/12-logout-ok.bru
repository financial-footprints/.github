meta {
  name: logout idempotent
  type: http
  seq: 12
}

post {
  url: {{jwtUrl}}/api/v1/auth/logout
  body: json
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "refresh_token": "{{managerRefreshToken}}"
  }
}

tests {
  test("logout 200", function () {
    expect(res.getStatus()).to.equal(200);
    expect(res.getBody().data).to.equal(null);
  });
}

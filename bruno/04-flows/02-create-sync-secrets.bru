meta {
  name: flow create sync secrets
  type: http
  seq: 2
}

post {
  url: {{syncUrl}}/api/v1/sync/accounts
  body: json
}

headers {
  Authorization: Bearer {{aliceAccessToken}}
  X-User-Id: {{userId}}
  X-Vault-Verification: {{vaultVerification}}
  Content-Type: application/json
}

body:json {
  {
    "id": "{{flowAccountId}}",
    "passwords": ["secret-hdfc"],
    "e2ee_account_number": "{{e2eeAccountNumber}}",
    "statement": {
      "text_contains": ["9999"]
    }
  }
}

tests {
  test("created secrets", function () {
    expect(res.getStatus()).to.equal(201);
    expect(res.getBody().data.id).to.equal(bru.getVar("flowAccountId"));
    expect(res.getBody().data.has_passwords).to.equal(true);
  });
}

# Image tags (override when publishing to a registry)
NETWORTHJWT_IMAGE=networthjwt:local
NETWORTHDB_IMAGE=networthdb:local
NETWORTHSYNC_IMAGE=networthsync:local

# Local bundled Postgres (profile: local)
POSTGRES_USER=networth
POSTGRES_PASSWORD=change-me
POSTGRES_DB=networth

# Shared secrets for local testing — replace before use
JWT_MFA_ENCRYPTION_KEY=
DB_STORAGE_MASTER_KEY=
SYNC_STORAGE_MASTER_KEY=
